{
  "name": "scrabblebot-bot-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "npm install --prefix ../spacetimedb && spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/strategy.test.ts",
    "build": "tsc",
    "bench": "tsx src/sim/bench.ts",
    "evolve": "tsx src/train/evolve.ts",
    "learn": "tsx src/train/learn.ts",
    "advisor": "tsx src/train/advisor.ts",
    "improve": "./improve.sh",
    "play": "./play.sh"
  },
  "dependencies": {
    "spacetimedb": "^2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
