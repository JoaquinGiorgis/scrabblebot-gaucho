{
  "rewrites": [
    {
      "source": "/docs",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/docs.md"
    },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/docs",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/docs.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    }
  ]
}
